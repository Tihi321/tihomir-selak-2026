---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page is not here. Return to Tihomir Selak’s professional site."
>
  <main id="main" class="wrap not-found">
    <p class="section-kicker">404 · Route not found</p>
    <h1>This page has no destination.</h1>
    <p>
      The link may have changed. You can head back to the home page and choose
      another route.
    </p>
    <a class="button button-primary" href="/">
      Return home <span aria-hidden="true">↗</span>
    </a>
  </main>
</BaseLayout>
