---
import '../styles/system/base.css';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  /** Adds a robots noindex, nofollow meta tag. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0F1215" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-martian-mono" preload />
    <title>{title} | Tihomir Selak</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
