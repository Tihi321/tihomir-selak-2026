---
import '../styles/system/base.css';
import { Font } from 'astro:assets';
import { person, site } from '../data/site';

interface Props {
  /** Page title. Without one the title is the site name plus the role. */
  title?: string;
  description?: string;
  /** Adds a robots noindex, nofollow meta tag. */
  noindex?: boolean;
  /** Path or URL of the social card image. */
  socialImage?: string;
}

const {
  title,
  description = site.description,
  noindex = false,
  socialImage = '/social-card.png',
} = Astro.props;
const fullTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} | ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const socialUrl = new URL(socialImage, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0F1215" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-martian-mono" preload />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialUrl} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(person)}
    ></script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div id="top"></div>
    <slot />
  </body>
</html>
