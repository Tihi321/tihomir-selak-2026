---
interface Props {
  /** Anchor id of the section. The heading gets `${id}-title`. */
  id: string;
  /** Section label, set as the h2 in the 2-column margin. */
  label: string;
}

const { id, label } = Astro.props;
const hasWide = Astro.slots.has('wide');
---

<section class="tile-section grid-12" id={id} aria-labelledby={`${id}-title`}>
  <h2 class="tile-section__label" id={`${id}-title`}>
    {label}
  </h2>
  <div class="tile-section__body">
    <slot />
  </div>
  {hasWide && (
    <div class="tile-section__wide">
      <slot name="wide" />
    </div>
  )}
</section>

<style>
  .tile-section {
    padding-block: var(--space-7);
    border-top: var(--border-hair);
    row-gap: var(--space-5);
  }

  .tile-section__label {
    max-width: none;
    grid-column: 1 / -1;
    font-size: var(--step-1);
    line-height: var(--lh-1);
    letter-spacing: -0.015em;
  }

  .tile-section__body {
    display: grid;
    gap: var(--space-5);
    grid-column: 1 / -1;
    min-width: 0;
    align-content: start;
  }

  @media (min-width: 1024px) {
    .tile-section__label {
      grid-column: 1 / span 2;
    }

    .tile-section__body {
      grid-column: 3 / span 10;
    }
  }

  /* Breaks out of the content column so the index uses the page grid. */
  .tile-section__wide {
    grid-column: 1 / -1;
    min-width: 0;
  }
</style>
