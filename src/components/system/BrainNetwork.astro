---
// Hero illustration: a hand-drawn lateral brain with a synapse web laid along
// its gyri, one slow signal and a few amber nodes firing. Decorative only.
type Point = readonly [number, number];
type Cubic = readonly [Point, Point, Point, Point];

const outline =
  'M52 150C30 120 44 72 88 58C112 34 158 28 190 44C228 34 274 62 280 104C298 128 292 170 268 184C262 214 228 226 204 214C192 236 162 242 146 224C124 240 92 228 92 204C62 200 44 176 52 150Z';
// Cerebellum and stem sit outside the hemisphere contour.
const base = [
  'M206 214C226 214 246 222 244 238C230 250 208 244 198 228',
  'M168 234C170 250 174 262 182 272',
];

// Each fold is a chain of cubic segments; nodes are sampled along them at
// irregular parameters, denser in the frontal (left) and parietal (right-top)
// regions.
const folds: readonly {
  segs: readonly Cubic[];
  ts: readonly (readonly number[])[];
}[] = [
  {
    segs: [
      [
        [66, 128],
        [72, 100],
        [92, 80],
        [118, 78],
      ],
      [
        [118, 78],
        [140, 76],
        [150, 92],
        [172, 84],
      ],
    ],
    ts: [
      [0.05, 0.28, 0.5, 0.88],
      [0.22, 0.6, 0.95],
    ],
  },
  {
    segs: [
      [
        [84, 170],
        [78, 146],
        [104, 132],
        [122, 140],
      ],
      [
        [122, 140],
        [140, 148],
        [150, 128],
        [176, 124],
      ],
    ],
    ts: [
      [0.1, 0.42, 0.8],
      [0.35, 0.72],
    ],
  },
  {
    segs: [
      [
        [92, 104],
        [104, 116],
        [96, 128],
        [112, 124],
      ],
    ],
    ts: [[0.25, 0.85]],
  },
  {
    segs: [
      [
        [176, 44],
        [164, 70],
        [182, 92],
        [170, 122],
      ],
    ],
    ts: [[0.12, 0.5, 0.92]],
  },
  {
    segs: [
      [
        [100, 200],
        [132, 184],
        [168, 196],
        [204, 172],
      ],
      [
        [204, 172],
        [224, 160],
        [246, 170],
        [266, 158],
      ],
    ],
    ts: [
      [0.12, 0.62],
      [0.3, 0.82],
    ],
  },
  {
    segs: [
      [
        [206, 62],
        [230, 78],
        [216, 102],
        [242, 118],
      ],
      [
        [242, 118],
        [258, 128],
        [256, 110],
        [268, 112],
      ],
    ],
    ts: [
      [0.08, 0.38, 0.72],
      [0.45, 0.92],
    ],
  },
  {
    segs: [
      [
        [226, 196],
        [214, 184],
        [236, 182],
        [250, 190],
      ],
    ],
    ts: [[0.2, 0.75]],
  },
  {
    segs: [
      [
        [150, 150],
        [170, 160],
        [190, 140],
        [212, 150],
      ],
      [
        [212, 150],
        [230, 158],
        [236, 146],
        [248, 148],
      ],
    ],
    ts: [
      [0.15, 0.5, 0.9],
      [0.3, 0.8],
    ],
  },
  {
    segs: [
      [
        [122, 62],
        [140, 54],
        [160, 64],
        [180, 58],
      ],
    ],
    ts: [[0.15, 0.55, 0.95]],
  },
  {
    segs: [
      [
        [72, 172],
        [92, 188],
        [86, 200],
        [112, 196],
      ],
    ],
    ts: [[0.3, 0.85]],
  },
];

const at = ([a, b, c, d]: Cubic, t: number): Point => {
  const u = 1 - t;
  const f = (i: 0 | 1) =>
    u ** 3 * a[i] + 3 * u * u * t * b[i] + 3 * u * t * t * c[i] + t ** 3 * d[i];
  return [f(0), f(1)];
};
const curve = (segs: readonly Cubic[]) =>
  segs
    .map(
      ([a, b, c, d], i) =>
        `${i === 0 ? `M${a[0]} ${a[1]}` : ''}C${b[0]} ${b[1]} ${c[0]} ${c[1]} ${d[0]} ${d[1]}`,
    )
    .join('');
const foldPaths = folds.map(({ segs }) => curve(segs));

// A fixed small offset breaks the regular spacing without a random seed.
const nodes: Point[] = [];
folds.forEach(({ segs, ts }) =>
  segs.forEach((seg, si) => {
    // Extra samples between every other pair break up the spacing.
    const samples = ts[si]!.flatMap((t, k, all) =>
      k % 2 === 0 && k + 1 < all.length
        ? [t, (t + all[k + 1]!) / 2 + 0.06 * ((si + k) % 3 === 0 ? 1 : -1)]
        : [t],
    );
    samples.forEach((t) => {
      const n = nodes.length;
      const [x, y] = at(seg, t);
      nodes.push([
        Math.round((x + ((n * 37) % 7) - 3) * 10) / 10,
        Math.round((y + ((n * 53) % 9) - 4) * 10) / 10,
      ]);
    });
  }),
);

const dist = (a: Point, b: Point) => Math.hypot(a[0] - b[0], a[1] - b[1]);
// Each node links to its 2 or 3 nearest neighbours, so edge lengths vary.
const edgeSet = new Set<string>();
nodes.forEach((node, i) => {
  nodes
    .map((other, j) => ({ j, d: dist(node, other) }))
    .filter(({ j, d }) => j !== i && d < 84)
    .sort((a, b) => a.d - b.d)
    .slice(0, 2 + (i % 2))
    .forEach(({ j }) => edgeSet.add(i < j ? `${i}-${j}` : `${j}-${i}`));
});
const edges = [...edgeSet].map(
  (key) => key.split('-').map(Number) as [number, number],
);
const neighbours = (i: number) =>
  edges.flatMap(([a, b]) => (a === i ? [b] : b === i ? [a] : []));

const nearest = (target: Point) =>
  nodes.reduce(
    (best, node, i) =>
      dist(node, target) < dist(nodes[best]!, target) ? i : best,
    0,
  );

// One signal walks the edges front to back, always to a neighbour further right.
const route = [nearest([66, 128])];
for (let step = 0; step < 30; step += 1) {
  const here = route[route.length - 1]!;
  const next = neighbours(here)
    .filter((i) => !route.includes(i) && nodes[i]![0] > nodes[here]![0])
    .sort(
      (a, b) => dist(nodes[a]!, nodes[here]!) - dist(nodes[b]!, nodes[here]!),
    )[0];
  if (next === undefined) break;
  route.push(next);
}
const signal = route
  .map((i, n) => `${n === 0 ? 'M' : 'L'}${nodes[i]![0]} ${nodes[i]![1]}`)
  .join('');
const firing = [
  nearest([110, 92]),
  nearest([200, 100]),
  nearest([150, 186]),
  nearest([244, 140]),
];
const isFiring = (i: number) => firing.includes(i);
---

<svg
  class="brain-network"
  viewBox="34 24 262 256"
  aria-hidden="true"
  focusable="false"
>
  <g class="brain-network__contour" fill="none">
    <path d={outline}></path>
    {base.map((d) => (
      <path d={d}></path>
    ))}
    {foldPaths.map((d) => (
      <path class="brain-network__fold" d={d}></path>
    ))}
  </g>
  <g class="brain-network__edges" fill="none">
    {edges.map(([a, b]) => (
      <line
        x1={nodes[a]![0]}
        y1={nodes[a]![1]}
        x2={nodes[b]![0]}
        y2={nodes[b]![1]}
      />
    ))}
  </g>
  <path
    class="brain-network__signal"
    d={signal}
    pathLength="1000"
    fill="none"
  ></path>
  <g class="brain-network__nodes">
    {nodes.map(([cx, cy], i) =>
      isFiring(i) ? (
        <circle
          class={`brain-network__fire brain-network__fire--${firing.indexOf(i)}`}
          cx={cx}
          cy={cy}
          r="3.4"
        />
      ) : (
        <circle cx={cx} cy={cy} r="2" />
      ),
    )}
  </g>
</svg>

<style>
  .brain-network {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .brain-network__contour path {
    stroke: var(--c-rule-strong);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .brain-network__contour .brain-network__fold {
    stroke-width: 1;
    opacity: 0.6;
  }

  .brain-network__edges line {
    stroke: var(--c-synapse);
    stroke-width: 1;
    opacity: 0.42;
    vector-effect: non-scaling-stroke;
  }

  .brain-network__nodes circle {
    fill: var(--c-synapse);
    opacity: 0.85;
  }

  .brain-network__nodes .brain-network__fire {
    fill: var(--c-phosphor);
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: brain-fire 5.2s var(--ease) infinite;
  }

  .brain-network__fire--1 {
    animation-delay: -1.3s;
  }

  .brain-network__fire--2 {
    animation-delay: -2.6s;
  }

  .brain-network__fire--3 {
    animation-delay: -3.9s;
  }

  .brain-network__signal {
    stroke: var(--c-phosphor);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 34 1000;
    stroke-dashoffset: 34;
    animation: brain-signal 9s linear infinite;
  }

  @keyframes brain-signal {
    to {
      stroke-dashoffset: -1000;
    }
  }

  @keyframes brain-fire {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.8);
    }
    12% {
      opacity: 1;
      transform: scale(1.35);
    }
    40% {
      opacity: 0.75;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brain-network__signal {
      display: none;
    }

    .brain-network__nodes .brain-network__fire {
      animation: none;
    }
  }
</style>
