---
import type { WritingEntry } from '../../lib/entries';

interface Props {
  entry: WritingEntry;
}

const { entry } = Astro.props;
---

<li class="writing-item" id={`entry-${entry.slug}`}>
  <time class="writing-item__date" datetime={entry.date}>
    {entry.date}
  </time>
  <a class="writing-item__title" href={entry.href}>
    {entry.title}
  </a>
  <span class="writing-item__topic">{entry.topic}</span>
  <span class="writing-item__time">{entry.minutes} min</span>
</li>

<style>
  .writing-item {
    position: relative;
    display: grid;
    grid-template-columns: 11ch minmax(0, 1fr) auto 6ch;
    grid-template-areas: 'date title topic time';
    align-items: baseline;
    column-gap: var(--space-5);
    padding: var(--space-3) 0;
    border-bottom: var(--border-hair);
    color: var(--c-graphite);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: var(--lh--2);
  }

  .writing-item__date {
    grid-area: date;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .writing-item__title {
    grid-area: title;
    color: var(--c-paper-bright);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: var(--lh-1);
    text-decoration: none;
  }

  .writing-item__title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .writing-item__title:focus-visible {
    outline: none;
  }

  .writing-item__title:focus-visible::after {
    outline: 2px solid var(--c-phosphor);
    outline-offset: 3px;
  }

  .writing-item:hover .writing-item__title,
  .writing-item:focus-within .writing-item__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .writing-item__topic {
    grid-area: topic;
    color: var(--c-graphite);
    white-space: nowrap;
  }

  .writing-item__time {
    grid-area: time;
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 719.98px) {
    .writing-item {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'date time'
        'title title'
        'topic topic';
      row-gap: var(--space-1);
    }
  }
</style>
