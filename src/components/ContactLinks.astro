---
import { site } from '../data/site';
---

<ul class="contact-links">
  <li>
    <a href={`mailto:${site.email}`}>
      Email <span aria-hidden="true">↗</span>
    </a>
  </li>
  <li>
    <a href={site.linkedin}>
      LinkedIn <span aria-hidden="true">↗</span>
    </a>
  </li>
  <li>
    <a href={site.github}>
      GitHub <span aria-hidden="true">↗</span>
    </a>
  </li>
</ul>
